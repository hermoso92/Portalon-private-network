# ============================================================
# PORTALON PRIVATE NETWORK - Environment Variables
# ============================================================
# USAGE:
#   cp .env.example .env
#   Fill in all values marked REQUIRED before running.
#   Values marked OPTIONAL have sensible defaults shown.
#
# SECURITY WARNING:
#   - NEVER commit .env to version control (it is in .gitignore)
#   - All JWT secrets must be cryptographically random strings >= 32 chars
#   - Generate secrets with: openssl rand -base64 48
#   - Change ALL default passwords before first deploy
#   - Database and Redis are NOT exposed externally by default (internal Docker network only)
# ============================================================

# -------------------------------------------------------
# APP
# -------------------------------------------------------
# REQUIRED: Set to 'production' in production environments
NODE_ENV=production

# OPTIONAL: Port the NestJS API listens on inside the container
PORT=3001

# REQUIRED: Full URL of the frontend (used for CORS). No trailing slash.
# Example: https://portalon.yourdomain.com
FRONTEND_URL=https://tu-dominio.com

# -------------------------------------------------------
# DATABASE (PostgreSQL)
# -------------------------------------------------------
# REQUIRED: Full Prisma connection string.
# In Docker Compose deployments, use the service name 'postgres' as host.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://portalon:CHANGE_ME_DB_PASSWORD@postgres:5432/portalon_db

# -------------------------------------------------------
# REDIS (used for rate-limiting / session cache)
# -------------------------------------------------------
# REQUIRED (for Docker deployment): Redis host (service name in docker-compose)
REDIS_HOST=redis

# OPTIONAL: Redis port (default 6379)
REDIS_PORT=6379

# REQUIRED: Redis auth password. Must match REDIS_PASSWORD below.
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# -------------------------------------------------------
# JWT AUTHENTICATION
# -------------------------------------------------------
# REQUIRED: Secret key for access tokens. Min 32 chars, must be random.
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS_RANDOM

# OPTIONAL: Access token expiry (default 15m)
JWT_EXPIRES_IN=15m

# REQUIRED: Secret key for refresh tokens. Must differ from JWT_SECRET.
# Generate with: openssl rand -base64 48
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_MIN_32_CHARS_RANDOM

# OPTIONAL: Refresh token expiry (default 7d)
JWT_REFRESH_EXPIRES_IN=7d

# -------------------------------------------------------
# AI - OpenClaw / Ollama-compatible
# -------------------------------------------------------
# OPTIONAL: Base URL for the AI inference server.
# For Docker deployments accessing host Ollama, use host.docker.internal
# For production, point to your inference server URL.
OPENCLAW_BASE_URL=http://localhost:11434

# OPTIONAL: Model name as installed in Ollama (default llama3.1)
OPENCLAW_MODEL=llama3.1

# OPTIONAL: Timeout in ms for AI requests (default 30000)
OPENCLAW_TIMEOUT=30000

# NOTE: If the AI service is unavailable, the system degrades gracefully -
# leads will receive a default score of 30 and no AI summary.

# -------------------------------------------------------
# FILE UPLOADS
# -------------------------------------------------------
# OPTIONAL: Directory for uploaded files inside the container
UPLOADS_DIR=/app/uploads

# OPTIONAL: Max file size in bytes (default 10MB = 10485760)
MAX_FILE_SIZE=10485760

# -------------------------------------------------------
# THROTTLING (rate limiting)
# -------------------------------------------------------
# OPTIONAL: Throttle window in ms (default 60000 = 1 minute)
THROTTLE_TTL=60000

# OPTIONAL: Max requests per window per IP (default 100)
# Public lead form has a stricter rate at the Nginx level (10r/m)
THROTTLE_LIMIT=100

# -------------------------------------------------------
# POSTGRES (used by docker-compose to initialize the container)
# Must match the credentials in DATABASE_URL above.
# -------------------------------------------------------
# OPTIONAL: Database name (default portalon_db)
POSTGRES_DB=portalon_db

# OPTIONAL: Database user (default portalon)
POSTGRES_USER=portalon

# REQUIRED: Database password. Must match the password in DATABASE_URL.
# *** WARNING: No default. Docker Compose will FAIL to start if this is empty. ***
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# -------------------------------------------------------
# NEXT.JS FRONTEND
# -------------------------------------------------------
# REQUIRED: Public API base URL accessible from the browser.
# Must be the full URL including /api/v1 path.
# Example: https://portalon.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=https://tu-dominio.com/api/v1

# OPTIONAL: Promotion slug to display on the public landing page
NEXT_PUBLIC_PROMOTION_SLUG=el-portalon-del-brillante
