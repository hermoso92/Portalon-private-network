// Portalon Private Network - Prisma Schema
// Red privada de distribución comercial para promociones inmobiliarias premium

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  PROMOTION_MANAGER
  SALES_AGENT
  PARTNER
  VIEWER
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PartnerRoleType {
  BROKER
  ADVISOR
  AGENCY
  REFERRER
  OTHER
}

enum PromotionPublicStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  PAUSED
  CLOSED
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  UNAVAILABLE
}

enum LeadSourceType {
  LANDING_PUBLIC
  PARTNER_REFERRAL
  PARTNER_MANUAL
  DIRECT
  ORGANIC
  PAID
  OTHER
}

enum BuyerType {
  UNKNOWN
  INVESTOR
  END_USER
  DEVELOPER
  CORPORATE
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  VISIT_SCHEDULED
  VISITED
  RESERVED
  WON
  LOST
}

enum LeadActivityType {
  STATUS_CHANGE
  NOTE_ADDED
  VISIT_SCHEDULED
  VISIT_COMPLETED
  CALL_LOGGED
  EMAIL_SENT
  DOCUMENT_SENT
  RESERVATION_CREATED
  SALE_CLOSED
  AI_SCORE_UPDATED
  ASSIGNED
  UNASSIGNED
}

enum AttributionStatus {
  ACTIVE
  OVERRIDDEN
  DISPUTED
  RESOLVED
}

enum CommissionTriggerType {
  ON_VISIT
  ON_RESERVATION
  ON_SALE
  ON_LEAD
}

enum CommissionCalculationType {
  FIXED_AMOUNT
  PERCENTAGE_OF_SALE
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
  DISPUTED
}

enum OperationMode {
  SALE
  SHORT_STAY
  MID_TERM
  LONG_TERM
}

enum AssetStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  OFF_MARKET
}

enum OwnerType {
  INDIVIDUAL
  COMPANY
}

enum OperatorAssignmentStatus {
  ACTIVE
  INACTIVE
}

enum AvailabilityBlockReason {
  BLOCKED
  MAINTENANCE
  RESERVED
  OCCUPIED
}

enum PriceUnit {
  TOTAL
  PER_NIGHT
  PER_MONTH
  PER_YEAR
}

enum InquiryType {
  PURCHASE
  SHORT_STAY_BOOKING
  MID_TERM_RENTAL
  LONG_TERM_RENTAL
  INFORMATION
}

// ============================================================
// MODELS
// ============================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  assignedLeads   Lead[]          @relation("AssignedLeads")
  leadActivities  LeadActivity[]
  auditLogs       AuditLog[]      @relation("ActorUser")
  refreshTokens   RefreshToken[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model Partner {
  id                 String          @id @default(cuid())
  name               String
  company            String?
  email              String          @unique
  phone              String?
  roleType           PartnerRoleType
  status             PartnerStatus   @default(PENDING)
  referralCode       String          @unique
  notes              String?
  bankName           String?
  bankAccountMasked  String?
  passwordHash       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Relations
  leads              Lead[]
  attributions       Attribution[]
  commissionEvents   CommissionEvent[]
  auditLogs          AuditLog[]      @relation("ActorPartner")
  refreshTokens      PartnerRefreshToken[]

  @@index([referralCode])
  @@index([status])
  @@index([email])
  @@map("partners")
}

model Promotion {
  id               String                @id @default(cuid())
  slug             String                @unique
  name             String
  headline         String?
  shortDescription String?
  fullDescription  String?
  location         String?
  address          String?
  city             String?
  country          String?
  currency         String                @default("EUR")
  publicStatus     PromotionPublicStatus @default(DRAFT)
  priceMin         Decimal?              @db.Decimal(12, 2)
  priceMax         Decimal?              @db.Decimal(12, 2)
  totalUnits       Int                   @default(0)
  unitsAvailable   Int                   @default(0)
  brochureUrl      String?
  heroImageUrl     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  // Relations
  units            Unit[]
  assets           PromotionAsset[]
  leads            Lead[]
  commissionRules  CommissionRule[]
  commissionEvents CommissionEvent[]

  @@index([slug])
  @@index([publicStatus])
  @@map("promotions")
}

model PromotionAsset {
  id          String   @id @default(cuid())
  promotionId String
  type        String   // image, video, brochure, floor_plan, etc.
  title       String?
  fileUrl     String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@map("promotion_assets")
}

model Unit {
  id               String         @id @default(cuid())
  promotionId      String
  unitCode         String
  title            String?
  bedrooms         Int?
  bathrooms        Int?
  interiorM2       Decimal?       @db.Decimal(8, 2)
  exteriorM2       Decimal?       @db.Decimal(8, 2)
  parkingIncluded  Boolean        @default(false)
  jacuzzi          Boolean        @default(false)
  price            Decimal?       @db.Decimal(12, 2)
  status           UnitStatus     @default(AVAILABLE)
  featured         Boolean        @default(false)
  sortOrder        Int            @default(0)
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Premium asset fields
  operationMode    OperationMode? @default(SALE)
  assetStatus      AssetStatus?   @default(AVAILABLE)
  ownerId          String?

  promotion            Promotion             @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  leads                Lead[]
  owner                Owner?                @relation(fields: [ownerId], references: [id])
  operatorAssignments  OperatorAssignment[]
  availabilityBlocks   AvailabilityBlock[]
  pricingProfiles      PricingProfile[]

  @@unique([promotionId, unitCode])
  @@index([promotionId])
  @@index([status])
  @@index([ownerId])
  @@index([operationMode])
  @@index([assetStatus])
  @@map("units")
}

model Lead {
  id               String        @id @default(cuid())
  promotionId      String
  unitId           String?
  partnerId        String?
  assignedToUserId String?
  sourceType       LeadSourceType
  firstName        String
  lastName         String?
  email            String?
  phone            String?
  country          String?
  language         String?
  budgetRange      String?
  buyerType        BuyerType     @default(UNKNOWN)
  interestLevel    String?
  score            Int?
  status           LeadStatus    @default(NEW)
  notes            String?
  aiSummary        String?
  aiRiskFlags      Json?
  attributionData  Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  promotion        Promotion       @relation(fields: [promotionId], references: [id])
  unit             Unit?           @relation(fields: [unitId], references: [id])
  partner          Partner?        @relation(fields: [partnerId], references: [id])
  assignedTo       User?           @relation("AssignedLeads", fields: [assignedToUserId], references: [id])
  activities       LeadActivity[]
  attribution      Attribution?
  commissionEvents CommissionEvent[]

  @@index([promotionId])
  @@index([partnerId])
  @@index([status])
  @@index([score])
  @@index([sourceType])
  @@index([buyerType])
  @@index([country])
  @@index([assignedToUserId])
  @@index([email])
  @@index([promotionId, status])
  @@index([partnerId, status])
  @@index([partnerId, createdAt])
  @@map("leads")
}

model LeadActivity {
  id           String           @id @default(cuid())
  leadId       String
  userId       String?
  activityType LeadActivityType
  payload      Json?
  createdAt    DateTime         @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([activityType])
  @@map("lead_activities")
}

model Attribution {
  id                String            @id @default(cuid())
  leadId            String            @unique
  partnerId         String
  sourceChannel     String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  clickId           String?
  attributionStatus AttributionStatus @default(ACTIVE)
  createdAt         DateTime          @default(now())

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
  @@index([attributionStatus])
  @@map("attributions")
}

model CommissionRule {
  id              String                    @id @default(cuid())
  promotionId     String
  triggerType     CommissionTriggerType
  calculationType CommissionCalculationType
  amount          Decimal                   @db.Decimal(12, 4)
  isActive        Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([triggerType])
  @@map("commission_rules")
}

model CommissionEvent {
  id               String                @id @default(cuid())
  promotionId      String
  leadId           String
  partnerId        String
  triggerType      CommissionTriggerType
  baseAmount       Decimal?              @db.Decimal(12, 2)
  commissionAmount Decimal               @db.Decimal(12, 2)
  status           CommissionStatus      @default(PENDING)
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  promotion Promotion @relation(fields: [promotionId], references: [id])
  lead      Lead      @relation(fields: [leadId], references: [id])
  partner   Partner   @relation(fields: [partnerId], references: [id])

  @@unique([leadId, triggerType])
  @@index([partnerId])
  @@index([promotionId])
  @@index([status])
  @@index([leadId])
  @@index([partnerId, status])
  @@map("commission_events")
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  actorPartnerId String?
  entityType     String
  entityId       String
  action         String
  oldValue       Json?
  newValue       Json?
  createdAt      DateTime @default(now())

  actorUser    User?    @relation("ActorUser", fields: [actorUserId], references: [id])
  actorPartner Partner? @relation("ActorPartner", fields: [actorPartnerId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([actorPartnerId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PartnerRefreshToken {
  id        String   @id @default(cuid())
  partnerId String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([partnerId])
  @@map("partner_refresh_tokens")
}

// ============================================================
// PREMIUM ASSET OPERATIONS MODELS
// ============================================================

model Owner {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?
  type      OwnerType
  taxId     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  units Unit[]

  @@index([email])
  @@index([type])
  @@map("owners")
}

model OperatorAssignment {
  id             String                   @id @default(cuid())
  unitId         String
  operatorName   String
  operatorEmail  String
  operatorPhone  String?
  startDate      DateTime
  endDate        DateTime?
  commissionRate Decimal                  @db.Decimal(5, 4)
  notes          String?
  status         OperatorAssignmentStatus @default(ACTIVE)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([status])
  @@index([operatorEmail])
  @@map("operator_assignments")
}

model AvailabilityBlock {
  id        String                  @id @default(cuid())
  unitId    String
  startDate DateTime
  endDate   DateTime
  reason    AvailabilityBlockReason
  notes     String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([startDate, endDate])
  @@map("availability_blocks")
}

model PricingProfile {
  id            String        @id @default(cuid())
  unitId        String
  operationMode OperationMode
  basePrice     Decimal       @db.Decimal(12, 2)
  currency      String        @default("EUR")
  priceUnit     PriceUnit
  minStay       Int?
  maxStay       Int?
  notes         String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([operationMode])
  @@index([isActive])
  @@map("pricing_profiles")
}
